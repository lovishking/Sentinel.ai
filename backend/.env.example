# ===========================================
# Sentinel AI - Backend Environment Variables
# ===========================================

# Application Server Port
PORT=4000

# PostgreSQL Connection String (with pgvector support)
DATABASE_URL="postgresql://sentinel:password@localhost:5432/sentinel_db?schema=public"

# Google Gemini API Key for LangGraph Agent Workflow
GEMINI_API_KEY="your-gemini-api-key-here"

# Redis Server URL (Job Queues & Caching)
REDIS_URL="redis://localhost:6379"

# Node Environment ('development' | 'production' | 'test')
NODE_ENV="development"
