generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

/// Represents a single production incident
model Incident {
  id          String   @id @default(uuid())
  title       String
  description String
  severity    String   @default("medium") // low, medium, high, critical
  status      String   @default("open") // open, investigating, resolving, closed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  evidences   Evidence[]
  runs        AgentRun[]
  fixes       Fix[]
}

model Evidence {
  id         String   @id @default(uuid())
  incidentId String
  type       String   // log, metric, stack_trace, user_report
  content    String
  createdAt  DateTime @default(now())

  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
}

model AgentRun {
  id         String   @id @default(uuid())
  incidentId String
  status     String   // running, completed, failed
  logs       Json     @default("[]") // Store LangGraph checkpoints or logs
  startedAt  DateTime @default(now())
  endedAt    DateTime?

  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
}

model Fix {
  id          String   @id @default(uuid())
  incidentId  String
  description String
  patch       String?  // Code diff
  status      String   // generated, testing, success, failed, applied
  prUrl       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
}

model CodeContext {
  id        String   @id @default(uuid())
  filePath  String
  content   String
  embedding Unsupported("vector(768)")?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HistoricalIncident {
  id          String   @id @default(uuid())
  title       String
  description String
  resolution  String
  embedding   Unsupported("vector(768)")?
  createdAt   DateTime @default(now())
}
